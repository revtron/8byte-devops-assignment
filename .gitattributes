# Files that are executed or rendered on Linux must stay LF even when checked
# out on Windows with core.autocrlf=true (the user-data template is embedded
# into EC2 cloud-init verbatim).
* text=auto
*.sh        text eol=lf
*.tftpl     text eol=lf
*.tf        text eol=lf
*.hcl       text eol=lf
*.example   text eol=lf
Jenkinsfile text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.ps1       text eol=crlf
