# Copy to monitoring/.env (gitignored). On the mon host this file is written by
# scripts/bootstrap/mon.sh from Secrets Manager + /etc/8byte/env — do not edit
# it by hand there.

# Grafana `admin` user password. mon.sh uses the Jenkins admin password from
# the 8byte/jenkins secret so there is one admin password to remember.
GRAFANA_ADMIN_PASSWORD=change-me

# postgres_exporter connection string to the RDS instance (8byte/db secret).
# RDS enforces TLS, hence sslmode=require.
PG_EXPORTER_DSN=postgresql://todo:change-me@8byte-db.xxxx.ap-south-1.rds.amazonaws.com:5432/todo_prod?sslmode=require

# SNS topic Alertmanager publishes to (same topic Jenkins uses for pipeline mail).
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:8byte-alerts

# Region used for SigV4 signing of the SNS publish (no static credentials —
# the mon instance role grants sns:Publish).
AWS_REGION=ap-south-1
