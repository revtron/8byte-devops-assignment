          "expr": "100 * sum(rate(pg_stat_database_blks_hit{datname=~\"todo_.*\"}[5m])) / (sum(rate(pg_stat_database_blks_hit{datname=~\"todo_.*\"}[5m])) + sum(rate(pg_stat_database_blks_read{datname=~\"todo_.*\"}[5m])))"
