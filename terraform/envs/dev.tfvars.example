# Copy to envs/dev.tfvars (gitignored) and fill in the values.
#
# Required order on a fresh account (the hosts read Secrets Manager at boot):
#   1. cd terraform/bootstrap && terraform apply
#   2. cd terraform && terraform init -backend-config=backend.hcl
#   3. terraform apply -var-file=envs/dev.tfvars -target=module.secrets
#   4. ../scripts/put-secrets.sh          # writes 8byte/dockerhub and 8byte/github
#   5. terraform apply -var-file=envs/dev.tfvars
admin_cidr       = "203.0.113.4/32"
admin_public_key = "ssh-ed25519 AAAA... you@laptop"
alert_email      = "you@example.com"
dockerhub_repo   = "yourdockerhubuser/todo"
github_repo      = "yourgithubuser/8byte"
git_ref          = "main"

# Optional overrides (defaults shown)
# project              = "8byte"
# env                  = "dev"
# region               = "ap-south-1"
# vpc_cidr             = "10.0.0.0/16"
# azs                  = ["ap-south-1a", "ap-south-1b"]
# instance_types       = { management = "t3.small", backend = "t3.micro", mon = "t3.small" }
# db_instance_class    = "db.t4g.micro"
# db_allocated_storage = 20
# db_backup_retention_days = 7   # set 1 on an AWS free-plan account
# tags                 = { Owner = "you" }
