# Copy to backend.hcl and fill in the account id printed by terraform/bootstrap.
#
# Order: bootstrap apply -> terraform init -backend-config=backend.hcl
#   -> terraform apply -target=module.secrets -> scripts/put-secrets.sh
#   -> terraform apply
bucket         = "8byte-tfstate-123456789012"
key            = "dev/terraform.tfstate"
region         = "ap-south-1"
dynamodb_table = "8byte-tflock"
encrypt        = true
